{
  "name": "slack-support-agent",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "A Slack support agent: an intake app and a BullMQ worker that runs a tool-using agent to investigate support requests across read-only tools.",
  "license": "MIT",
  "author": "Joe Garber",
  "repository": {
    "type": "git",
    "url": "https://github.com/joegarb/slack-support-agent.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "intake": "tsx intake/index.ts",
    "worker": "tsx worker/index.ts",
    "simulate": "tsx intake/simulate.ts",
    "redis:up": "docker compose up -d redis",
    "redis:down": "docker compose down",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.82",
    "@ai-sdk/openai": "^4.0.96",
    "@slack/bolt": "^5.1.0",
    "@slack/web-api": "^8.2.0",
    "ai": "^7.0.143",
    "bullmq": "^6.3.16",
    "dotenv": "^18.0.8",
    "ioredis": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
