# Redis (defaults to the local docker-compose instance)
REDIS_URL=redis://127.0.0.1:6379

# LLM provider
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# LLM_MODEL=anthropic:claude-sonnet-5
# LLM_SUBAGENT_MODEL=anthropic:claude-haiku-4-5

# Local checkout of the app for codebase search (unset skips the code sub-agent)
# CODE_REPO_DIR=/path/to/your-app

# Slack: Socket Mode
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Slack: Events API
SLACK_SIGNING_SECRET=...
PORT=8080
